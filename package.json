{
  "name": "audio-mixer",
  "version": "2.0.0",
  "private": true,
  "description": "Desktop audio routing and mixing app with per-application capture.",
  "author": "Luna",
  "productName": "Audio Mixer",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "test": "node --test \"test/*.test.mjs\" && cd src-tauri && cargo test",
    "test:ui": "node --test \"test/*.test.mjs\"",
    "test:rust": "cd src-tauri && cargo test",
    "check": "node scripts/check-syntax.cjs",
    "build": "tauri build",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
